                            <element name="5030101231_double_effet_magnetic_31.elmt">
                                <definition type="element" link_type="simple" hotspot_x="40" hotspot_y="19" width="90" height="50" version="0.90">
                                    <uuid uuid="{6686a539-c000-5cb4-c431-210d0ffba23e}"/>
                                    <names>
                                        <name lang="ar">مزدوج الفعل + فرملة محدودة على كلا الجانبين + قابل للتعديل + مغناطيس + فرامل مغلقة بشكل طبيعي</name>
                                        <name lang="ca">Doble efecte + fre de límit a banda i banda + regulable + imant + fre normalment tancat</name>
                                        <name lang="cs">Dvojčinná + koncová brzda na obou stranách + nastavitelná + magnet + brzda normálně zavřená</name>
                                        <name lang="da">Dobbeltvirkende + grænsebremse på begge sider + justerbar + magnet + bremse normalt lukket</name>
                                        <name lang="de">Doppeltwirkend + Endlagenbremse beidseitig + einstellbar + Magnet + Bremse normal geschlossen</name>
                                        <name lang="el">Διπλής δράσης + οριακό φρένο και στις δύο πλευρές + ρυθμιζόμενο + μαγνήτης + φρένο κανονικά κλειστό</name>
                                        <name lang="en">Double-acting + limit brake on both sides + adjustable + magnet + brake normally closed</name>
                                        <name lang="es">Doble efecto + freno de límite en ambos lados + ajustable + imán + freno normalmente cerrado</name>
                                        <name lang="fr">Double effet + frein de fin de course des deux côtés + réglable + aimant + frein normalement fermé</name>
                                        <name lang="hr">Dvostruko djelovanje + granična kočnica s obje strane + podesiva + magnet + kočnica normalno zatvorena</name>
                                        <name lang="hu">Kettős működésű + határfék mindkét oldalon + állítható + mágnes + fék alaphelyzetben zárva</name>
